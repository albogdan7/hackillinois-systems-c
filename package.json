{
  "name": "hackillinois-volunteer-api",
  "version": "1.0.0",
  "description": "Volunteer shift signup backend API",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "ts-node src/server.ts",
